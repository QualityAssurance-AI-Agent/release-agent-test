{
  "rules": [
    {
      "rule_type": "require_gate_before",
      "job_class": "code-review",
      "before": "deploy"
    },
    {
      "rule_type": "require_gate_before",
      "job_class": "security-scan",
      "before": "deploy"
    },
    {
      "rule_type": "require_gate_before",
      "job_class": "unit-test",
      "before": "deploy",
      "paths": [
        "src/**",
        "services/**",
        "lib/**",
        "*.py",
        "*.js",
        "*.ts",
        "*.go"
      ]
    },
    {
      "rule_type": "require_environment_before",
      "environment": "gamma",
      "before_environment": "prod"
    },
    {
      "rule_type": "require_approval",
      "stage_selector": "production"
    }
  ],
  "summary": "Release governance: peer review, unit tests, clean security scan, load test for backend changes, pre-production before production, production requires approval."
}
